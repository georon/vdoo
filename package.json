{
  "name": "vdoo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "productName": "vdoo",
  "description": "Design database tables and relationships as ER diagrams, with an AI assistant",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "app": "npm run build && node scripts/start.mjs",
    "start": "node scripts/start.mjs",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "test": "vitest run && node --test scripts/test-claude-path.cjs scripts/test-files.cjs scripts/test-pdf.cjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dompurify": "3.4.18",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "jsdom": "29.1.1",
    "mermaid": "12.3.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "app.vdoo.editor",
    "productName": "vdoo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "vdoo",
        "name": "vdoo schema",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "artifactName": "vdoo-Setup.exe"
    },
    "portable": {
      "artifactName": "vdoo-Portable.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
